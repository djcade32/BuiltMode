{
  "name": "builtmode",
  "main": "expo-router/entry",
  "version": "alpha.2.1.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest --config jest.client.config.js",
    "test:unit": "npm run test -- tests/unit",
    "test:integration": "npm run test -- tests/integration --runInBand",
    "test:server": "GCLOUD_PROJECT=demo-builtmode FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 jest --config functions/jest.config.ts",
    "test:all": "npm run test && npm run test:server",
    "build:shared": "npm --workspace @builtmode/shared run build",
    "build:functions:watch": "npm --workspace functions run build:watch",
    "build:functions": "npm --workspace functions run build",
    "build": "npm run build:shared && npm run build:functions",
    "eas-build-pre-install": "npm install --workspaces=false",
    "eas-build-post-install": "npm run build -w @builtmode/shared"
  },
  "dependencies": {
    "@builtmode/shared": "workspace:*",
    "@expo-google-fonts/archivo-black": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo/ui": "~56.0.21",
    "@expo/vector-icons": "^15.0.3",
    "@formatjs/intl-datetimeformat": "^7.4.9",
    "@formatjs/intl-getcanonicallocales": "^3.2.10",
    "@formatjs/intl-locale": "^5.3.9",
    "@formatjs/intl-numberformat": "^9.3.11",
    "@formatjs/intl-pluralrules": "^6.3.10",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-firebase/app": "^24.1.1",
    "@react-native-firebase/messaging": "^24.1.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@tanstack/react-query": "^5.99.0",
    "babel-preset-expo": "~56.0.0",
    "dayjs": "^1.11.19",
    "expo": "^56.0.15",
    "expo-asset": "~56.0.19",
    "expo-audio": "~56.0.12",
    "expo-camera": "~56.0.8",
    "expo-constants": "~56.0.20",
    "expo-dev-client": "~56.0.22",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.11",
    "expo-image-picker": "~56.0.20",
    "expo-linking": "~56.0.15",
    "expo-localization": "~56.0.6",
    "expo-notifications": "~56.0.20",
    "expo-router": "~56.2.14",
    "expo-splash-screen": "~56.0.12",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.6",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.5",
    "expo-widgets": "~56.0.9",
    "firebase": "^12.10.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.2",
    "react-native": "0.85.3",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-get-random-values": "~1.11.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-mmkv": "^4.1.2",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-popup-menu": "^0.19.0",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-toast-message": "^2.3.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "react-timer-hook": "^4.0.5",
    "uuid": "^13.0.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~56.0.4",
    "jest": "~29.7.0",
    "jest-expo": "~56.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "private": true,
  "workspaces": [
    "functions",
    "packages/*"
  ]
}
