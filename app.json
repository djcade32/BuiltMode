{
  "expo": {
    "name": "BuiltMode",
    "slug": "BuiltMode",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ios-icon.png",
    "scheme": "builtmode",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.djcade32.BuiltMode",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to capture workout photos and videos.",
        "NSPhotoLibraryUsageDescription": "Allow access to save workout photos.",
        "NSPhotoLibraryAddUsageDescription": "Allow saving workout progress photos.",
        "NSMicrophoneUsageDescription": "Allow recording audio during workout videos."
      },
      "googleServicesFile": "./GoogleService-Info.plist",
      "entitlements": {
        "aps-environment": "development"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F1113",
        "foregroundImage": "./assets/images/full_logo.png",
        "backgroundImage": "./assets/images/full_logo.png",
        "monochromeImage": "./assets/images/full_logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA", "android.permission.RECORD_AUDIO"],
      "googleServicesFile": "./google-services.json",

      "package": "com.djcade32.BuiltMode"
    },
    "notification": {
      "icon": "./assets/images/ios-icon.png"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/ios-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/full_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F1113",
          "dark": {
            "backgroundColor": "#0F1113"
          }
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow BuiltMode to access your camera",
          "microphonePermission": "Allow BuiltMode to access your microphone",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": ["./assets/sounds/double_bell.mp3"]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BuiltMode accesses your photos to let you share them with your friends."
        }
      ],
      "expo-localization",
      "expo-audio",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7227f810-5ace-45f0-a887-b173b6f1812c"
      }
    }
  }
}
