{
  "compilerOptions": {
    "module": "NodeNext",
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "baseUrl": ".",
    "paths": {
      "@builtmode/shared/types/*": ["../packages/shared/dist/types/*"],
      "@builtmode/shared/schemas/*": ["../packages/shared/dist/schemas/*"]
    },
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "rootDir": "src",
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2017"
  },
  "compileOnSave": true,
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/tests",
    "**/*.test.ts",
    "**/*.spec.ts"
  ],
  "extends": "expo/tsconfig.base"
}
